---
// Request a Quote form. Posts to the Pages Function at /api/quote (functions/api/quote.ts).
// Field rules come from src/lib/quote-rules.ts, which the server uses too.
// Photos are resized and re-encoded to JPEG in the browser, which also strips EXIF/GPS metadata;
// any image the browser can't convert (e.g. HEIC on most desktop browsers) is refused, never uploaded.
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { PROJECT_TYPES, UPLOAD_LIMITS } from '@/lib/quote-rules';

// Cloudflare's always-pass test key is used when no real key is configured (local development).
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || TEST_SITE_KEY;
if (siteKey === TEST_SITE_KEY && import.meta.env.PROD) {
  console.warn('[quote form] PUBLIC_TURNSTILE_SITE_KEY is not set — building with the Turnstile TEST key.');
}

const photoGroups = [
  {
    group: 'space',
    label: 'Photos of the space',
    hint: 'The room or wall as it is now. A wide shot plus a few closer ones works best.',
    max: UPLOAD_LIMITS.space,
  },
  {
    group: 'inspiration',
    label: 'Inspiration images',
    hint: 'Screenshots or saved photos of styles you like.',
    max: UPLOAD_LIMITS.inspiration,
  },
] as const;

const accept = 'image/jpeg,image/png,image/webp,image/heic,image/heif';
---

<form
  action="/api/quote"
  method="post"
  enctype="multipart/form-data"
  novalidate
  class="flex flex-col gap-12"
  data-quote-form
>
  <div
    class="rounded-md border-2 border-accent bg-card p-6"
    role="alert"
    tabindex="-1"
    hidden
    data-error-summary
  >
    <h2 class="text-h4" data-error-title>Please check the form</h2>
    <ul class="mt-4 flex list-disc flex-col gap-2 pl-6" data-error-list></ul>
    <p class="mt-4 hidden text-sm" data-error-contact>
      You can also reach us directly: call <a href={site.phone.href} class="font-semibold underline">{site.phone.display}</a>,
      message us on <a href={site.whatsapp} class="font-semibold underline" target="_blank" rel="noopener">WhatsApp</a>{' '}
      or email <a href={site.email.href} class="font-semibold underline break-all">{site.email.display}</a>.
    </p>
  </div>

  <fieldset class="flex flex-col gap-6">
    <legend class="text-h3 mb-6">Your details</legend>

    <div>
      <label for="quote-name" class="field-label">Name <span class="field-tag">Required</span></label>
      <input id="quote-name" name="name" type="text" class="field-input" autocomplete="name" required maxlength="100" aria-describedby="quote-name-error" />
      <p id="quote-name-error" class="field-error" hidden></p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="quote-phone" class="field-label">Phone <span class="field-tag">Required</span></label>
        <input id="quote-phone" name="phone" type="tel" class="field-input" autocomplete="tel" inputmode="tel" required maxlength="30" aria-describedby="quote-phone-error" />
        <p id="quote-phone-error" class="field-error" hidden></p>
      </div>
      <div>
        <label for="quote-email" class="field-label">Email <span class="field-tag">Required</span></label>
        <input id="quote-email" name="email" type="email" class="field-input" autocomplete="email" required maxlength="254" spellcheck="false" aria-describedby="quote-email-error" />
        <p id="quote-email-error" class="field-error" hidden></p>
      </div>
    </div>

    <div>
      <label for="quote-city" class="field-label">City or town <span class="field-tag">Required</span></label>
      <input id="quote-city" name="city" type="text" class="field-input" autocomplete="address-level2" list="quote-towns" required maxlength="100" aria-describedby="quote-city-error" />
      <datalist id="quote-towns">{site.towns.map((town) => <option value={town} />)}</datalist>
      <p id="quote-city-error" class="field-error" hidden></p>
    </div>
  </fieldset>

  <fieldset class="flex flex-col gap-6">
    <legend class="text-h3 mb-6">Your project</legend>

    <div>
      <label for="quote-type" class="field-label">Project type <span class="field-tag">Required</span></label>
      <select id="quote-type" name="projectType" class="field-input" required aria-describedby="quote-type-error">
        <option value="">Choose one</option>
        {PROJECT_TYPES.map((type) => <option value={type}>{type}</option>)}
      </select>
      <p id="quote-type-error" class="field-error" hidden></p>
    </div>

    <div>
      <label for="quote-dimensions" class="field-label">Rough dimensions <span class="field-tag">Optional</span></label>
      <p id="quote-dimensions-hint" class="field-hint">For example: wall about 12 ft wide × 8 ft high.</p>
      <input id="quote-dimensions" name="dimensions" type="text" class="field-input" maxlength="200" aria-describedby="quote-dimensions-hint quote-dimensions-error" />
      <p id="quote-dimensions-error" class="field-error" hidden></p>
    </div>

    <div>
      <label for="quote-description" class="field-label">Project description <span class="field-tag">Required</span></label>
      <p id="quote-description-hint" class="field-hint">What you'd like built, the finish or colours you have in mind, and anything we should know about the space.</p>
      <textarea id="quote-description" name="description" class="field-input" rows="6" required maxlength="3000" aria-describedby="quote-description-hint quote-description-error"></textarea>
      <p id="quote-description-error" class="field-error" hidden></p>
    </div>
  </fieldset>

  <fieldset class="flex flex-col gap-8">
    <legend class="text-h3 mb-2">Photos</legend>
    <p class="text-muted">
      Photos help us quote accurately. Large phone photos are resized before upload, and location data is removed.
    </p>

    {
      photoGroups.map(({ group, label, hint, max }) => (
        <div data-photo-picker={group} data-max={max}>
          <p id={`quote-${group}-label`} class="field-label">
            {label} <span class="field-tag">Optional · up to {max}</span>
          </p>
          <p id={`quote-${group}-hint`} class="field-hint">{hint} JPEG, PNG or WebP.</p>
          <label class="btn btn-outline mt-4">
            <Icon name="image" size={20} />
            <span data-photo-button-text>Add photos</span>
            <input
              type="file"
              name={group}
              accept={accept}
              multiple
              class="sr-only"
              aria-describedby={`quote-${group}-hint quote-${group}-error quote-${group}-status`}
              data-photo-input
            />
          </label>
          <p id={`quote-${group}-error`} class="field-error" hidden data-photo-error />
          <p id={`quote-${group}-status`} class="field-hint" aria-live="polite" data-photo-status />
          <ul class="mt-4 grid grid-cols-3 gap-2 empty:hidden sm:grid-cols-4" aria-labelledby={`quote-${group}-label`} data-photo-list />
        </div>
      ))
    }
  </fieldset>

  <!-- Honeypot: hidden from people and assistive technology; bots that fill it are ignored. -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for="quote-company">Company</label>
    <input id="quote-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="flex flex-col gap-6 border-t border-line pt-8">
    <div>
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action="quote"
        data-theme="light"
        data-size="flexible"
        data-refresh-expired="auto"
      >
      </div>
      <p id="quote-turnstile-error" class="field-error" hidden data-turnstile-error></p>
    </div>

    <noscript>
      <p class="rounded-md border border-line bg-card p-6">
        This form needs JavaScript to check for spam and prepare your photos. You can reach us directly instead: call{' '}
        <a href={site.phone.href} class="font-semibold underline">{site.phone.display}</a>, message us on{' '}
        <a href={site.whatsapp} class="font-semibold underline">WhatsApp</a> or email{' '}
        <a href={site.email.href} class="font-semibold underline">{site.email.display}</a>.
      </p>
    </noscript>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <button type="submit" class="btn btn-primary sm:min-w-56" data-submit>
        <span data-submit-text>Request a Quote</span>
      </button>
      <p class="text-sm text-muted" aria-live="polite" data-submit-status></p>
    </div>

    <p class="max-w-[60ch] text-sm text-muted">
      We use your details and photos only to prepare your quote. See our <a href="/privacy" class="underline">privacy policy</a>.
    </p>
  </div>
</form>

<script>
  import {
    FIELD_NAMES,
    MESSAGES,
    UPLOAD_LIMITS,
    normaliseFields,
    validateField,
    type FieldErrors,
    type FieldName,
    type PhotoGroup,
  } from '@/lib/quote-rules';

  declare global {
    interface Window {
      turnstile?: { reset: (widget?: string | HTMLElement) => void };
    }
  }

  type Photo = { blob: Blob; previewUrl: string };

  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');

  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const summaryTitle = form.querySelector<HTMLElement>('[data-error-title]')!;
    const summaryList = form.querySelector<HTMLUListElement>('[data-error-list]')!;
    const summaryContact = form.querySelector<HTMLElement>('[data-error-contact]')!;
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitText = form.querySelector<HTMLElement>('[data-submit-text]')!;
    const submitStatus = form.querySelector<HTMLElement>('[data-submit-status]')!;
    const turnstileError = form.querySelector<HTMLElement>('[data-turnstile-error]')!;

    const control = (name: FieldName) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const errorFor = (name: FieldName) => document.getElementById(`${control(name).id}-error`)!;
    const touched = new Set<FieldName>();
    let sending = false;

    // ---------- Field validation ----------

    const readFields = () =>
      normaliseFields(Object.fromEntries(FIELD_NAMES.map((name) => [name, control(name).value])));

    const showFieldError = (name: FieldName, message?: string) => {
      const input = control(name);
      const error = errorFor(name);
      error.textContent = message ?? '';
      error.hidden = !message;
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    };

    const checkField = (name: FieldName) => {
      const message = validateField(name, readFields()[name]);
      showFieldError(name, message);
      return message;
    };

    for (const name of FIELD_NAMES) {
      const input = control(name);
      // Check when leaving a field, never while someone is still typing…
      input.addEventListener('blur', () => {
        if (input.value.trim() || touched.has(name)) {
          touched.add(name);
          checkField(name);
        }
      });
      // …but clear an error as soon as it's fixed.
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true' && !validateField(name, readFields()[name])) {
          showFieldError(name);
        }
      });
    }

    // ---------- Photos: resize, re-encode to JPEG (drops EXIF/GPS), preview ----------

    const photos: Record<PhotoGroup, Photo[]> = { space: [], inspiration: [] };

    async function decode(file: File): Promise<ImageBitmap | HTMLImageElement> {
      try {
        // Applies the photo's EXIF orientation, so the re-encoded JPEG is the right way up.
        return await createImageBitmap(file, { imageOrientation: 'from-image' });
      } catch {
        // Safari can decode some formats (e.g. HEIC) through <img> but not createImageBitmap.
        const url = URL.createObjectURL(file);
        try {
          const img = new Image();
          img.src = url;
          await img.decode();
          return img;
        } finally {
          URL.revokeObjectURL(url);
        }
      }
    }

    async function toJpeg(file: File): Promise<Blob> {
      const image = await decode(file);
      const width = 'naturalWidth' in image ? image.naturalWidth : image.width;
      const height = 'naturalHeight' in image ? image.naturalHeight : image.height;
      if (!width || !height) throw new Error('empty image');

      const scale = Math.min(1, UPLOAD_LIMITS.resizeEdge / Math.max(width, height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      const context = canvas.getContext('2d');
      if (!context) throw new Error('no canvas');
      // White behind transparent PNG/WebP areas, since JPEG has no transparency.
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      if ('close' in image) image.close();

      const blob = await new Promise<Blob | null>((resolve) =>
        canvas.toBlob(resolve, 'image/jpeg', UPLOAD_LIMITS.jpegQuality),
      );
      // A canvas-encoded JPEG carries no EXIF/GPS. Anything else means the conversion didn't happen.
      if (!blob || blob.type !== 'image/jpeg') throw new Error('encode failed');
      return blob;
    }

    form.querySelectorAll<HTMLElement>('[data-photo-picker]').forEach((picker) => {
      const group = picker.dataset.photoPicker as PhotoGroup;
      const max = UPLOAD_LIMITS[group];
      const input = picker.querySelector<HTMLInputElement>('[data-photo-input]')!;
      const list = picker.querySelector<HTMLUListElement>('[data-photo-list]')!;
      const error = picker.querySelector<HTMLElement>('[data-photo-error]')!;
      const status = picker.querySelector<HTMLElement>('[data-photo-status]')!;
      const buttonText = picker.querySelector<HTMLElement>('[data-photo-button-text]')!;

      const showErrors = (messages: string[]) => {
        error.textContent = messages.join(' ');
        error.hidden = messages.length === 0;
      };

      const render = () => {
        list.replaceChildren(
          ...photos[group].map((photo, index) => {
            const item = document.createElement('li');
            item.className = 'relative';
            const img = document.createElement('img');
            img.src = photo.previewUrl;
            img.alt = group === 'space' ? `Photo ${index + 1} of the space` : `Inspiration image ${index + 1}`;
            img.className = 'aspect-square w-full rounded object-cover bg-line';
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className =
              'absolute top-1 right-1 inline-flex size-11 items-center justify-center rounded bg-paper/90 text-ink hover:bg-paper';
            remove.setAttribute('aria-label', `Remove ${img.alt.charAt(0).toLowerCase()}${img.alt.slice(1)}`);
            remove.innerHTML =
              '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
            remove.addEventListener('click', () => {
              URL.revokeObjectURL(photo.previewUrl);
              photos[group].splice(index, 1);
              showErrors([]);
              render();
              status.textContent = `Photo removed. ${photos[group].length} of ${max} added.`;
              input.focus();
            });
            item.append(img, remove);
            return item;
          }),
        );
        const count = photos[group].length;
        buttonText.textContent = count ? 'Add more photos' : 'Add photos';
        input.disabled = count >= max;
        input.closest('label')!.setAttribute('aria-disabled', String(count >= max));
      };

      input.addEventListener('change', async () => {
        const files = Array.from(input.files ?? []);
        input.value = '';
        if (!files.length) return;

        const messages: string[] = [];
        const room = max - photos[group].length;
        if (files.length > room) messages.push(MESSAGES.tooManyPhotos(group));

        status.textContent = 'Preparing photos…';
        for (const file of files.slice(0, Math.max(room, 0))) {
          try {
            const blob = await toJpeg(file);
            if (blob.size > UPLOAD_LIMITS.fileBytes) {
              messages.push(MESSAGES.fileTooLarge(file.name));
              continue;
            }
            photos[group].push({ blob, previewUrl: URL.createObjectURL(blob) });
          } catch {
            // Couldn't convert safely (e.g. HEIC the browser can't read) — refuse rather than upload the original.
            messages.push(MESSAGES.unsupportedImage(file.name));
          }
        }

        showErrors(messages);
        render();
        status.textContent = `${photos[group].length} of ${max} added.`;
      });
    });

    // ---------- Submit ----------

    const showSummary = (title: string, items: { text: string; href?: string }[], withContact: boolean) => {
      summaryTitle.textContent = title;
      summaryList.replaceChildren(
        ...items.map(({ text, href }) => {
          const li = document.createElement('li');
          if (href) {
            const link = document.createElement('a');
            link.href = href;
            link.textContent = text;
            link.className = 'underline';
            link.addEventListener('click', (event) => {
              event.preventDefault();
              document.querySelector<HTMLElement>(href)?.focus();
            });
            li.append(link);
          } else {
            li.textContent = text;
          }
          return li;
        }),
      );
      summaryList.hidden = items.length === 0;
      summaryContact.classList.toggle('hidden', !withContact);
      summary.hidden = false;
      summary.focus();
      summary.scrollIntoView({ block: 'start' });
    };

    const showFieldErrors = (errors: FieldErrors, extra: string[] = []) => {
      const items: { text: string; href?: string }[] = [];
      for (const name of FIELD_NAMES) {
        showFieldError(name, errors[name]);
        if (errors[name]) items.push({ text: errors[name]!, href: `#${control(name).id}` });
      }
      for (const text of extra) items.push({ text });
      showSummary('Please check the form', items, false);
    };

    const setSending = (on: boolean, label = 'Sending…') => {
      sending = on;
      submitButton.disabled = on;
      submitButton.setAttribute('aria-busy', String(on));
      submitText.textContent = on ? label : 'Request a Quote';
      if (!on) submitStatus.textContent = '';
    };

    const resetTurnstile = () => {
      try {
        window.turnstile?.reset();
      } catch {
        /* widget not rendered */
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (sending) return;

      FIELD_NAMES.forEach((name) => touched.add(name));
      const fields = readFields();
      const errors: FieldErrors = {};
      for (const name of FIELD_NAMES) {
        const message = validateField(name, fields[name]);
        if (message) errors[name] = message;
      }

      const token = (form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null)?.value ?? '';
      turnstileError.hidden = Boolean(token);
      const extra: string[] = [];
      if (!token) {
        const message = window.turnstile
          ? 'Please complete the verification check above the button.'
          : "The verification check didn't load. Please turn off any content blocker for this page and reload it.";
        turnstileError.textContent = message;
        extra.push(message);
      }

      if (Object.keys(errors).length || extra.length) {
        showFieldErrors(errors, extra);
        // If Turnstile never loaded, offer the direct contact options as well.
        summaryContact.classList.toggle('hidden', Boolean(window.turnstile));
        return;
      }

      summary.hidden = true;
      const data = new FormData();
      for (const name of FIELD_NAMES) data.append(name, fields[name]);
      data.append('company', (form.elements.namedItem('company') as HTMLInputElement).value);
      data.append('cf-turnstile-response', token);
      for (const group of ['space', 'inspiration'] as const) {
        photos[group].forEach((photo, index) =>
          data.append(group, photo.blob, `${group}-${String(index + 1).padStart(2, '0')}.jpg`),
        );
      }

      // XMLHttpRequest rather than fetch, because it reports upload progress.
      const request = new XMLHttpRequest();
      request.open('POST', form.action);
      request.setRequestHeader('Accept', 'application/json');
      request.responseType = 'json';
      request.timeout = 120_000;

      request.upload.addEventListener('progress', (progress) => {
        if (progress.lengthComputable) {
          const percent = Math.round((progress.loaded / progress.total) * 100);
          submitText.textContent = percent < 100 ? `Sending… ${percent}%` : 'Sending…';
        }
      });

      const failed = (message: string) => {
        setSending(false);
        resetTurnstile();
        showSummary("Your request didn't send", [{ text: message }], true);
      };

      request.addEventListener('load', () => {
        const body = request.response as
          | { ok: true; reference: string }
          | { ok: false; code: string; message: string; fieldErrors?: FieldErrors; fileErrors?: string[] }
          | null;

        if (body?.ok) {
          submitStatus.textContent = 'Request sent.';
          window.location.assign(`/contact/thanks?ref=${encodeURIComponent(body.reference)}`);
          return;
        }

        setSending(false);
        resetTurnstile();
        if (body && body.code === 'invalid') {
          showFieldErrors(body.fieldErrors ?? {}, body.fileErrors ?? []);
        } else if (body && body.code === 'verification') {
          turnstileError.textContent = body.message;
          turnstileError.hidden = false;
          showSummary('Please check the form', [{ text: body.message }], false);
        } else {
          failed(body?.message ?? 'Something went wrong on our side. Please try again in a few minutes.');
        }
      });
      request.addEventListener('error', () =>
        failed('Check your internet connection and try again. Everything you entered is still here.'),
      );
      request.addEventListener('timeout', () =>
        failed('Sending took too long. Check your connection, or try again with fewer photos.'),
      );

      setSending(true);
      submitStatus.textContent = 'Sending your request…';
      request.send(data);
    });
  }
</script>
