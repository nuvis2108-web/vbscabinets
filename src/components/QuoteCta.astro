---
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
---

<section id="quote" class="bg-ink py-16 text-white md:py-24" aria-labelledby="quote-title" data-hides-action-bar>
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal>
      <p class="eyebrow text-line">Free quotes</p>
      <h2 id="quote-title" class="text-h2 mt-4">Have a kitchen, closet or feature wall in mind?</h2>
      <p class="text-lead mt-4 max-w-[52ch] text-white/80">
        Send us photos of the space, rough dimensions and any inspiration images. We'll look at the layout,
        materials and finish, and come back with a quote for your build.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={site.quote.href} class="btn btn-primary">Request a Quote</a>
        <a href={site.phone.href} class="btn btn-outline-light">
          <Icon name="phone" size={20} />
          Call {site.phone.display}
        </a>
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal>
      <h3 class="eyebrow text-line">Other ways to reach us</h3>
      <ul class="mt-4 border-t border-white/15">
        <li class="border-b border-white/15">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="flex min-h-14 items-center gap-4 hover:text-line">
            <Icon name="message" size={20} />
            <span>WhatsApp <span class="text-white/70">· {site.phone.display}</span></span>
          </a>
        </li>
        <li class="border-b border-white/15">
          <a href={site.email.href} class="flex min-h-14 items-center gap-4 break-all hover:text-line">
            <Icon name="mail" size={20} />
            <span>{site.email.display}</span>
          </a>
        </li>
        <li class="border-b border-white/15">
          <a href={site.instagram.url} target="_blank" rel="noopener" class="flex min-h-14 items-center gap-4 hover:text-line">
            <Icon name="instagram" size={20} />
            <span>Instagram <span class="text-white/70">· {site.instagram.handle}</span></span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
