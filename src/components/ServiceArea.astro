---
import { site } from '@/data/site';
---

<section id="service-area" class="section" aria-labelledby="service-area-title">
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <p class="eyebrow">Service area</p>
      <h2 id="service-area-title" class="text-h2 mt-4">Based in Hamilton, working across the GTA.</h2>
    </div>
    <div class="lg:col-span-6">
      <p class="text-lead text-muted">
        We build and install for homeowners in the towns below and across the Greater Toronto Area. If you're nearby
        but don't see your town listed, get in touch and ask.
      </p>
      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Areas we serve">
        {
          site.towns.map((area) => (
            <li class="rounded-full border border-line bg-card px-4 py-2 text-sm">{area}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
