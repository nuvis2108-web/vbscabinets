---
import { Picture } from 'astro:assets';
import { formatDate, isoDate, postUrl, type BlogPost } from '@/lib/blog';

interface Props {
  post: BlogPost;
  /** Heading level for the title, so cards fit the page outline. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { title, description, category, publishDate, featuredImage, featuredImageAlt } = post.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<!-- The title link stretches over the whole card, so there is one link per card for keyboard and screen-reader users. -->
<article class="group relative flex flex-col">
  <div class="overflow-hidden rounded-md bg-line">
    <Picture
      src={featuredImage}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[400, 600, 800]}
      sizes="(min-width: 1180px) 360px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
      alt={featuredImageAlt}
      loading="lazy"
      class="aspect-3/2 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
    />
  </div>
  <p class="eyebrow mt-6">{category}</p>
  <Heading class="text-h4 mt-2">
    <a
      href={postUrl(post)}
      class="underline-offset-4 group-hover:underline after:absolute after:inset-0 after:rounded-md focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-ink"
    >
      {title}
    </a>
  </Heading>
  <p class="mt-2 line-clamp-3 max-w-[60ch] text-muted">{description}</p>
  <p class="mt-4 text-sm text-muted">
    <time datetime={isoDate(publishDate)}>{formatDate(publishDate)}</time>
  </p>
</article>
