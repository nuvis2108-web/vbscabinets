---
import { Picture } from 'astro:assets';
// TODO(content): temporary services image. Replace with a real VBS closet photo when one is available —
// closets are priority service #2 and have no photo yet. Never fill this with a rendered or AI image.
import carvedDoor from '@/assets/images/custom-woodwork-detail.jpg';

// Priority order per the design skill: cabinetry, closets, media walls, built-ins, woodworking.
const services = [
  {
    title: 'Custom Cabinetry',
    text: 'Kitchen cabinetry, storage cabinets and tailored cabinetry for everyday living, built to your layout and finish.',
  },
  {
    title: 'Closets',
    text: 'Reach-in and walk-in closet layouts with shelving, hanging space, drawers and practical storage.',
  },
  {
    title: 'Media Walls',
    text: 'TV walls, fluted feature panels and display shelving, with integrated lighting where you want it.',
  },
  {
    title: 'Built-ins',
    text: 'Fireplace built-ins, benches and storage walls designed around the shape of your room.',
  },
  {
    title: 'Custom Woodworking',
    text: 'Made-to-order furniture and one-off pieces — dressers, nightstands, doors and gates.',
  },
];

const alsoAvailable = ['Floating shelves', 'Garage shelving', 'Sliding closet doors'];
---

<section id="services" class="section border-t border-line" aria-labelledby="services-title">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
    <figure class="order-last lg:order-first lg:col-span-5">
      <div class="overflow-hidden rounded-md bg-line lg:sticky lg:top-28">
        <Picture
          src={carvedDoor}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1180px) 440px, (min-width: 1024px) 38vw, 100vw"
          alt="Teak door and frame with ornamental relief carving, fluted pillars and pierced lattice panels"
          loading="lazy"
          class="aspect-4/5 w-full object-cover object-top"
        />
      </div>
      <figcaption class="mt-4 text-sm text-muted">Custom teak door installation</figcaption>
    </figure>

    <div class="lg:col-span-7">
      <p class="eyebrow">What we build</p>
      <h2 id="services-title" class="text-h2 mt-4">Custom work for every room.</h2>
      <p class="text-lead mt-4 max-w-[52ch] text-muted">
        From practical storage to a full feature wall, every piece is built around your space, your needs and your
        preferred finish.
      </p>

      <ol class="mt-12 border-t border-line">
        {
          services.map((service, i) => (
            <li class="grid gap-2 border-b border-line py-6 sm:grid-cols-[64px_1fr] sm:gap-6 sm:py-8">
              <span class="text-xs font-extrabold tracking-[0.18em] text-accent" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-h3">{service.title}</h3>
                <p class="mt-2 max-w-[56ch] text-muted">{service.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 text-sm text-muted">
        <span class="font-semibold text-ink">Also available:</span>{' '}
        {alsoAvailable.join(' · ')}
      </p>
    </div>
  </div>
</section>
