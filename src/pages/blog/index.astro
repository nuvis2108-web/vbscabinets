---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import QuoteCta from '@/components/QuoteCta.astro';
import { site } from '@/data/site';
import { getPosts, isoDate, postUrl } from '@/lib/blog';

const posts = await getPosts();
const description = `Practical guides to custom closets, cabinetry, media walls and built-ins from ${site.name}, serving ${site.serviceAreaText}.`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${site.name} Blog`,
    description,
    url: `${site.url}/blog`,
    inLanguage: 'en-CA',
    publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: new URL(postUrl(post), site.url).href,
      datePublished: isoDate(post.data.publishDate),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
    ],
  },
];
---

<BaseLayout title={`Blog | ${site.name}`} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="section pt-10 md:pt-16" aria-labelledby="blog-title">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Blog</p>
        <h1 id="blog-title" class="text-display mt-4">Guides for planning your build</h1>
        <p class="text-lead mt-6 text-muted">
          Straight answers to the questions we hear most about closets, cabinetry, media walls and built-ins, for
          homeowners in {site.serviceAreaText}.
        </p>
      </div>

      <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>

  <QuoteCta />
</BaseLayout>
