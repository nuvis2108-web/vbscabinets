---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';

const steps = [
  { title: 'We review your request', text: 'We look at your photos, dimensions and description.' },
  { title: 'We follow up', text: 'We get in touch to talk through the layout, materials and finish.' },
  { title: 'You get a clear quote', text: 'A project quote with an estimated timeline.' },
];
---

<BaseLayout
  title="Request a Quote | VBS Closets & Cabinets"
  description={`Request a free quote for custom cabinetry, closets, media walls or built-ins. Serving ${site.serviceAreaText}.`}
  actionBar={false}
>
  <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="section pt-10 md:pt-16" aria-labelledby="contact-title">
    <div class="container-site grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">Free quotes</p>
        <h1 id="contact-title" class="text-display mt-4">Request a Quote</h1>
        <p class="text-lead mt-6 max-w-[52ch] text-muted">
          Tell us about the space and what you'd like built. Photos and rough dimensions help us give you an accurate
          quote.
        </p>

        <div class="mt-12">
          <QuoteForm />
        </div>
      </div>

      <aside class="flex flex-col gap-12 lg:col-span-5 lg:pt-32" aria-label="What happens next and other ways to reach us">
        <div class="lg:sticky lg:top-28 flex flex-col gap-12">
          <div class="rounded-md border border-line bg-card p-6 sm:p-8">
            <h2 class="text-h4">What happens next</h2>
            <ol class="mt-6 flex flex-col gap-6">
              {
                steps.map((step, i) => (
                  <li class="grid grid-cols-[32px_1fr] gap-2">
                    <span class="text-xs font-extrabold tracking-[0.18em] text-accent" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <h3 class="font-sans font-semibold">{step.title}</h3>
                      <p class="mt-1 text-sm text-muted">{step.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div>
            <h2 class="eyebrow">Prefer to talk?</h2>
            <ul class="mt-4 border-t border-line">
              <li class="border-b border-line">
                <a href={site.phone.href} class="flex min-h-14 items-center gap-4 hover:text-accent">
                  <Icon name="phone" size={20} />
                  <span>Call <span class="text-muted">· {site.phone.display}</span></span>
                </a>
              </li>
              <li class="border-b border-line">
                <a href={site.whatsapp} target="_blank" rel="noopener" class="flex min-h-14 items-center gap-4 hover:text-accent">
                  <Icon name="message" size={20} />
                  <span>WhatsApp <span class="text-muted">· {site.phone.display}</span></span>
                </a>
              </li>
              <li class="border-b border-line">
                <a href={site.email.href} class="flex min-h-14 items-center gap-4 break-all hover:text-accent">
                  <Icon name="mail" size={20} />
                  <span>{site.email.display}</span>
                </a>
              </li>
            </ul>
            <p class="mt-6 text-sm text-muted">Serving {site.serviceAreaText}.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
